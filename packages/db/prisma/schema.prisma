// The data model for the entire app. Boilerplate — empty schema with no models.
// Example branches add their own models, enums, and migrations here.

generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  userName       String
  blockList      URL[]    @relation("BlockedURLs")
  URLs           URL[]    @relation("UserURLs")
  createdAt      DateTime @default(now())
}

model URL {
  urlId         String      @id @default(cuid())
  normalizedURL String      @unique
  safetyScoreId String
  safetyScore   SafetyScore @relation(fields: [safetyScoreId], references: [id])
  createdAt     DateTime    @default(now())
  users         User[]      @relation("UserURLs")
  blockedBy     User[]      @relation("BlockedURLs")
}

model SafetyScore {
  id           String      @id @default(cuid())
  label        String
  levelOfRisk  Int
  feedback     String[]
  URLs         URL[]
}
